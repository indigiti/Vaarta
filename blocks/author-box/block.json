{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vaarta/author-box",
  "version": "0.1.0",
  "title": "Author Box",
  "category": "theme",
  "icon": "admin-users",
  "description": "Reusable article author profile.",
  "keywords": ["author", "profile", "bio"],
  "textdomain": "vaarta",
  "usesContext": ["postId", "postType"],
  "attributes": {
    "showAvatar": {
      "type": "boolean",
      "default": true
    },
    "showBio": {
      "type": "boolean",
      "default": true
    },
    "showArchiveLink": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
