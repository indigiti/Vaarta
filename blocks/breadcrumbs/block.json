{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vaarta/breadcrumbs",
  "version": "0.1.0",
  "title": "Breadcrumbs",
  "category": "vaarta",
  "icon": "arrow-right-alt2",
  "description": "Semantic breadcrumb navigation for editorial templates.",
  "keywords": ["breadcrumbs", "navigation", "seo"],
  "textdomain": "vaarta",
  "usesContext": ["postId", "postType"],
  "attributes": {
    "showCurrent": {
      "type": "boolean",
      "default": true
    },
    "showCategory": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
