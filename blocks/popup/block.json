{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vaarta/popup",
  "version": "0.1.0",
  "title": "Popup",
  "category": "design",
  "icon": "welcome-view-site",
  "description": "Reusable popup with arbitrary Gutenberg content and configurable triggers.",
  "keywords": ["popup", "modal", "newsletter", "promotion"],
  "textdomain": "vaarta",
  "attributes": {
    "trigger": {
      "type": "string",
      "default": "button"
    },
    "buttonLabel": {
      "type": "string",
      "default": "Open"
    },
    "delayMs": {
      "type": "number",
      "default": 5000
    },
    "scrollPercent": {
      "type": "number",
      "default": 50
    },
    "oncePerSession": {
      "type": "boolean",
      "default": true
    },
    "size": {
      "type": "string",
      "default": "medium"
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "interactivity": true,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "viewScriptModule": "file:./view.js",
  "render": "file:./render.php"
}
