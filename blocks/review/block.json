{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vaarta/review",
  "version": "0.1.0",
  "title": "Review Rating",
  "category": "vaarta",
  "icon": "star-filled",
  "description": "Editorial review score supporting percentage, points, and stars.",
  "keywords": [
    "review",
    "rating",
    "stars",
    "score"
  ],
  "textdomain": "vaarta",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Review"
    },
    "summary": {
      "type": "string",
      "default": ""
    },
    "score": {
      "type": "number",
      "default": 80
    },
    "scale": {
      "type": "string",
      "default": "percent"
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
