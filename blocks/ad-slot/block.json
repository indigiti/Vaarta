{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vaarta/ad-slot",
  "version": "0.1.0",
  "title": "Ad Slot",
  "category": "widgets",
  "icon": "megaphone",
  "description": "Reserved advertising placement with stable dimensions.",
  "keywords": ["advertisement", "ad", "monetization", "banner"],
  "textdomain": "vaarta",
  "attributes": {
    "slotName": {
      "type": "string",
      "default": "content-inline"
    },
    "minHeight": {
      "type": "number",
      "default": 250
    },
    "showLabel": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
