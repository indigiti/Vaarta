{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vaarta/related-posts",
  "version": "0.1.0",
  "title": "Related Stories",
  "category": "vaarta",
  "icon": "networking",
  "description": "Related stories based on the current article categories.",
  "keywords": [
    "related",
    "posts",
    "stories",
    "articles"
  ],
  "textdomain": "vaarta",
  "usesContext": [
    "postId",
    "postType"
  ],
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Related Stories"
    },
    "postsToShow": {
      "type": "number",
      "default": 3
    },
    "layout": {
      "type": "string",
      "default": "grid"
    }
  },
  "supports": {
    "align": [
      "wide"
    ],
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
