{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vaarta/search-overlay",
  "version": "0.1.0",
  "title": "Search Overlay",
  "category": "vaarta",
  "icon": "search",
  "description": "Instant editorial search overlay.",
  "keywords": [
    "search",
    "overlay",
    "instant search"
  ],
  "textdomain": "vaarta",
  "attributes": {
    "buttonLabel": {
      "type": "string",
      "default": "Search"
    },
    "placeholder": {
      "type": "string",
      "default": "Search stories…"
    },
    "resultsLimit": {
      "type": "number",
      "default": 6
    },
    "showButtonLabel": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "interactivity": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "viewScriptModule": "file:./view.js",
  "render": "file:./render.php"
}
