{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vaarta/tabs",
  "version": "0.1.0",
  "title": "Tabs / Pills",
  "category": "vaarta",
  "icon": "index-card",
  "description": "Accessible interactive tabs with arbitrary nested Gutenberg content.",
  "keywords": [
    "tabs",
    "pills",
    "interactive",
    "content"
  ],
  "textdomain": "vaarta",
  "attributes": {
    "styleVariant": {
      "type": "string",
      "default": "tabs"
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "interactivity": true,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "viewScriptModule": "file:./view.js",
  "render": "file:./render.php"
}
