{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vaarta/progress",
  "version": "0.1.0",
  "title": "Progress",
  "category": "widgets",
  "icon": "chart-bar",
  "description": "Reusable editorial progress or metric bar.",
  "keywords": ["progress", "metric", "percentage", "score"],
  "textdomain": "vaarta",
  "attributes": {
    "label": {
      "type": "string",
      "default": "Progress"
    },
    "value": {
      "type": "number",
      "default": 75
    },
    "showValue": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
