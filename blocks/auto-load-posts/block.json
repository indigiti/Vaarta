{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vaarta/auto-load-posts",
  "version": "0.1.0",
  "title": "Auto-load Next Articles",
  "category": "theme",
  "icon": "update",
  "description": "Continuously append older articles as the reader reaches the end of a story.",
  "keywords": ["autoload", "infinite", "article", "continuous reading"],
  "textdomain": "vaarta",
  "usesContext": ["postId", "postType"],
  "attributes": {
    "maxPosts": {
      "type": "number",
      "default": 3
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "interactivity": true,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "viewScriptModule": "file:./view.js",
  "render": "file:./render.php"
}
