{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vaarta/category-cards",
  "version": "0.2.0",
  "title": "Category Cards",
  "category": "vaarta",
  "icon": "category",
  "description": "Reusable editorial category cards with post counts.",
  "keywords": [
    "categories",
    "topics",
    "taxonomy",
    "cards"
  ],
  "textdomain": "vaarta",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Explore Topics"
    },
    "categorySlugs": {
      "type": "array",
      "default": []
    },
    "maxCategories": {
      "type": "number",
      "default": 5
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "showDescription": {
      "type": "boolean",
      "default": false
    },
    "layout": {
      "type": "string",
      "default": "grid"
    },
    "showImage": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
