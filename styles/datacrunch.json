{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Vaarta Datacrunch",
  "settings": {
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "canvas",
          "name": "Canvas",
          "color": "#fffdf8"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#171511"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#756f64"
        },
        {
          "slug": "line",
          "name": "Line",
          "color": "#e8e0d3"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#f5efe4"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#6352d8"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "Arial, Helvetica, sans-serif"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "Arial, Helvetica, sans-serif",
          "fontWeight": "700",
          "lineHeight": "1.02",
          "letterSpacing": "-0.025em"
        }
      },
      "button": {
        "border": {
          "radius": "4px"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "4px"
        }
      },
      "core/image": {
        "border": {
          "radius": "4px"
        }
      }
    }
  }
}
