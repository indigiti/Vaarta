{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Vaarta Tech",
  "settings": {
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "canvas",
          "name": "Canvas",
          "color": "#ffffff"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#111216"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#737780"
        },
        {
          "slug": "line",
          "name": "Line",
          "color": "#e7e9ee"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#f5f6f8"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#5b5cf0"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "lineHeight": "1.58"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "fontWeight": "760",
          "lineHeight": "1.02",
          "letterSpacing": "-0.025em"
        }
      },
      "button": {
        "border": {
          "radius": "6px"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "4px"
        },
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "700",
          "lineHeight": "1"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "right": "18px",
            "bottom": "12px",
            "left": "18px"
          }
        }
      },
      "core/image": {
        "border": {
          "radius": "6px"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "650",
          "lineHeight": "1"
        }
      },
      "core/site-title": {
        "typography": {
          "fontWeight": "820",
          "letterSpacing": "-0.045em",
          "lineHeight": "1"
        }
      }
    }
  }
}
