{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "canvas",
          "name": "Canvas",
          "color": "#ffffff"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#111111"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#6b6b6b"
        },
        {
          "slug": "line",
          "name": "Line",
          "color": "#e8e8e8"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#f6f6f4"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#5b5cf0"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "2xs",
          "name": "2XS",
          "size": "4px"
        },
        {
          "slug": "xs",
          "name": "XS",
          "size": "8px"
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "12px"
        },
        {
          "slug": "md",
          "name": "Medium",
          "size": "20px"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "32px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "48px"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "72px"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "96px"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Vaarta Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "md",
          "name": "Medium",
          "size": "1rem"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "1.25rem"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "1.75rem"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "clamp(2.25rem, 5vw, 4.75rem)"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "clamp(3.5rem, 7vw, 7rem)"
        }
      ]
    },
    "blocks": {
      "core/image": {
        "lightbox": {
          "enabled": true,
          "allowEditing": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--md)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.05",
          "letterSpacing": "-0.02em"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--muted)"
          }
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "single-article-1",
      "title": "Article Layout 1 — Centered",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "single-article-2",
      "title": "Article Layout 2 — Media Lead",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "single-article-3",
      "title": "Article Layout 3 — Split Hero",
      "postTypes": [
        "post"
      ]
    }
  ]
}
