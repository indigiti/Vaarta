{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "canvas",
          "name": "Canvas",
          "color": "#ffffff"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#f6f6f4"
        },
        {
          "slug": "surface-alt",
          "name": "Surface Alt",
          "color": "#efefec"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#111111"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#6b6b6b"
        },
        {
          "slug": "line",
          "name": "Line",
          "color": "#e6e6e2"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#5b5cf0"
        },
        {
          "slug": "accent-contrast",
          "name": "Accent Contrast",
          "color": "#ffffff"
        },
        {
          "slug": "inverse-canvas",
          "name": "Inverse Canvas",
          "color": "#111214"
        },
        {
          "slug": "inverse-ink",
          "name": "Inverse Ink",
          "color": "#f7f7f5"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "vw",
        "%"
      ],
      "spacingSizes": [
        {
          "slug": "2xs",
          "name": "2XS",
          "size": "4px"
        },
        {
          "slug": "xs",
          "name": "XS",
          "size": "8px"
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "12px"
        },
        {
          "slug": "md",
          "name": "Medium",
          "size": "20px"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "32px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "48px"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "72px"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "96px"
        },
        {
          "slug": "4xl",
          "name": "4XL",
          "size": "128px"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "dropCap": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Vaarta Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif"
        },
        {
          "slug": "editorial",
          "name": "Vaarta Editorial",
          "fontFamily": "Georgia, \"Times New Roman\", serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "md",
          "name": "Medium",
          "size": "1rem"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "1.25rem"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "1.75rem"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "clamp(2.15rem, 4vw, 4.25rem)"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "clamp(3.2rem, 6.5vw, 6.5rem)"
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(3.8rem, 8vw, 8.5rem)"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "blocks": {
      "core/image": {
        "lightbox": {
          "enabled": true,
          "allowEditing": true
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": true,
          "fontWeight": true,
          "letterSpacing": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--md)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.02",
          "letterSpacing": "-0.035em"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--muted)"
          }
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--canvas)"
        },
        "spacing": {
          "padding": {
            "top": "0.72rem",
            "right": "1.1rem",
            "bottom": "0.72rem",
            "left": "1.1rem"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "700"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontWeight": "800",
          "letterSpacing": "-0.045em"
        }
      },
      "core/post-title": {
        "typography": {
          "lineHeight": "1",
          "letterSpacing": "-0.04em"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "700"
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var(--wp--preset--color--muted)"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "single-article-1",
      "title": "Article Layout 1 — Centered",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "single-article-2",
      "title": "Article Layout 2 — Media Lead",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "single-article-3",
      "title": "Article Layout 3 — Split Hero",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "page-contact",
      "title": "Page — Contact",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-team",
      "title": "Page — Meet the Team",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-coming-soon",
      "title": "Page — Coming Soon",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-demo",
      "title": "Page — Demo Canvas",
      "postTypes": [
        "page"
      ]
    }
  ]
}
